+// matugen (Material You): re-reads ~/.config/matugen/generated/whatsie.css on
+// every (re)load so a wallpaper-driven theme change is picked up automatically.
+// The CSS is shipped as base64 to avoid any escaping issues with the generated
+// content, then base64-decoded in-page into the whatsie-matugen-theme <style>.
+void WebView::applyMatugenTheme()
+{
+    if (m_page == nullptr) {
+        return;
+    }
+    QFile cssFile(QDir::homePath() + QStringLiteral("/.config/matugen/generated/whatsie.css"));
+    if (!cssFile.open(QIODevice::ReadOnly)) {
+        return;
+    }
+    const QByteArray cssUtf8 = cssFile.readAll();
+    if (cssUtf8.isEmpty()) {
+        return;
+    }
+    const QString cssB64 = QString::fromLatin1(cssUtf8.toBase64());
+    const QString js = QStringLiteral(R"JS(
+(function () {
+    try {
+        var id = 'whatsie-matugen-theme';
+        var el = document.getElementById(id);
+        if (!el) {
+            el = document.createElement('style');
+            el.type = 'text/css';
+            el.id = id;
+            document.head.appendChild(el);
+        }
+        el.textContent = atob('%1');
+    } catch (e) {}
+})();
+)JS").arg(cssB64);
+    m_page->runJavaScript(js, QWebEngineScript::MainWorld);
+    qCDebug(lcWeb) << "matugen theme css injected";
+}
